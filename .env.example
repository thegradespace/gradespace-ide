# Optional: Clerk sign-in for Connect source builds
# Gradespace's relay runs in owner mode with no Clerk, so these stay empty. To use
# a Clerk deployment, fill them in from your Clerk Dashboard under API keys, JWT
# templates, and OAuth applications. They are public identifiers, not secrets.
# Do not add server-side secrets, or the Connect owner token, to this file.

T3CODE_CLERK_PUBLISHABLE_KEY=
T3CODE_CLERK_JWT_TEMPLATE=
T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in T3CODE_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# T3CODE_APPLE_TEAM_ID=ABC1234567
# T3CODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/t3code.provisionprofile
# T3CODE_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Relay URL. Empty keeps Connect off. Delete the line and server builds embed
# Gradespace's relay, https://connect.thegradespace.com. `infra/relay` deploys
# update it automatically.
T3CODE_RELAY_URL=

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow and for
# shareable links. There is no default; unset means no hosted app.
# T3CODE_HOSTED_APP_URL=https://app.example.com

# Optional: analytics. Nothing is sent unless both are set.
# T3CODE_POSTHOG_KEY=
# T3CODE_POSTHOG_HOST=

# Public, ingest-only mobile OpenTelemetry configuration.
# T3CODE_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# T3CODE_MOBILE_OTLP_TRACES_DATASET=t3-code-mobile-traces-dev
# T3CODE_MOBILE_OTLP_TRACES_TOKEN=xaat-...
