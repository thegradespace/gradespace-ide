# Settings for the self-hosted Node relay (docker-compose.yml in this folder).
# Copy this file to .env.node, fill it in, and keep .env.node out of git:
#   cp .env.node.example .env.node
#   docker compose --env-file .env.node up --detach --build
# Every value below is a placeholder. Generate your own secrets.

# --- Address ---------------------------------------------------------------

# Required. The origin phones and servers reach the relay at: scheme and host,
# no path. Clients sign this into every DPoP proof, so it must be the public
# address even when a TLS proxy or tunnel forwards to the container over http.
RELAY_PUBLIC_ORIGIN=https://connect.example.com

# Optional. The port the relay is published on, on 127.0.0.1 only. Point your
# TLS proxy or tunnel at it. Default 8787.
# RELAY_HOST_PORT=8787

# --- Owner sign-in ---------------------------------------------------------

# Required. The one secret that signs in every device of the owner: paste it
# into `gs connect link` on each computer and into the phone app. Anyone who
# has it is the owner, and replacing it is the only way to revoke it.
# At least 32 characters. Generate with: openssl rand -hex 32
RELAY_OWNER_TOKEN=

# Optional. The user id all of the owner's rows are stored under. Pick it once:
# changing it later orphans every link and device. Letters, digits and _ . : -
# Default owner.
# RELAY_OWNER_USER_ID=owner

# --- Relay keys ------------------------------------------------------------

# Required. Ed25519 private key (PKCS#8 PEM) that signs the tokens the relay
# issues. Put it on one line with \n between the PEM lines. Replacing it signs
# every phone out until it next exchanges its token. Generate with:
#   openssl genpkey -algorithm ed25519 | awk 'NF {printf "%s\\n", $0}'
RELAY_MINT_PRIVATE_KEY=

# Required. Signs queued push jobs so only this relay's own jobs are sent.
# At least 32 characters. Generate with: openssl rand -hex 32
RELAY_JOB_SIGNING_SECRET=

# --- Apple push (APNs) -----------------------------------------------------

# Optional. Set to false to run without Apple pushes; the APNS_* values below
# are then not needed. Default true.
# APNS_ENABLED=true

# Required with APNs. Used for a device that did not report its own: production
# for TestFlight and App Store builds, sandbox for development builds.
APNS_ENVIRONMENT=production

# Required with APNs. Your Apple Developer team id (10 characters).
APNS_TEAM_ID=

# Required with APNs. The key id of the APNs auth key (.p8) from
# Apple Developer > Certificates, Identifiers & Profiles > Keys.
APNS_KEY_ID=

# Required with APNs. The app's bundle id, used as the push topic for a device
# that did not report its own.
APNS_BUNDLE_ID=

# Required with APNs. The contents of the .p8 key on one line, with \n between
# the PEM lines. One team key serves sandbox and production. Make the line with:
#   awk 'NF {printf "%s\\n", $0}' AuthKey_XXXXXXXXXX.p8
APNS_PRIVATE_KEY=

# Optional, for testing only. Sends pushes to this base URL instead of Apple,
# for example a local fake. Leave unset in production.
# APNS_BASE_URL=

# --- Postgres --------------------------------------------------------------

# Required. Password of the bundled Postgres. Use only letters and digits: it
# is placed inside the connection URL. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Optional. The port Postgres is published on, on 127.0.0.1 only, for pg_dump
# backups from the host. Default 5432.
# POSTGRES_HOST_PORT=5432

# --- Set by docker-compose.yml ---------------------------------------------
# Only needed when you run `node src/node/main.ts` without Compose:
#   RELAY_AUTH_MODE   owner (this file) or clerk, which then needs
#                     CLERK_SECRET_KEY, CLERK_PUBLISHABLE_KEY, CLERK_JWT_AUDIENCE
#   DATABASE_URL      postgres://user:password@host:5432/database
#   RELAY_HOST        listen address, default 127.0.0.1 (0.0.0.0 in the image)
#   RELAY_PORT        listen port, default 8787
